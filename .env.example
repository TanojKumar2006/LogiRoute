# Placeholders only. Never commit real values.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Supabase: use the pooler (transaction) connection string from Project Settings > Database
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: path-free PEM text of the Supabase CA to fully verify TLS
DATABASE_SSL_CA=
# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-32+-character-random-secret
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated frontend origins allowed for CORS and auth
ALLOWED_ORIGINS=http://localhost:5173
# Shared secret that GPS devices / carrier webhooks send in the x-device-key header
DEVICE_API_KEY=replace-with-long-random-key
